# Values belong to YOUR services. Do not use builder credentials.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Generate a long random value for contact rate-limit hashing.
CONTACT_HASH_SECRET=
# Optional notification email. Submissions still save without it.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
CONTACT_NOTIFY_EMAIL=
# Temporary bootstrap inputs. Remove after creating the administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

